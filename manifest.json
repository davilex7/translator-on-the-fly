// manifest.json
// Configuración para cargar librerías localmente.
// Corregido: Añadido tesseract.min.js a web_accessible_resources.
{
  "manifest_version": 3,
  "name": "Traductor de Manga (Local Libs)",
  "version": "0.2.1", // Incrementa la versión
  "description": "Traduce texto dentro de imágenes en páginas web (ej. manga) usando librerías locales.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
    // Considerar añadir 'blob:' a worker-src si Tesseract lo necesita en el futuro:
    // "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self' blob:;"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"], // Asumiendo que moviste content.js a js/
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  // --- INICIO: Recursos Web Accesibles (CORREGIDO) ---
  "web_accessible_resources": [
    {
      // Permite que la página web acceda a estos archivos específicos.
      "resources": [
        "libs/tesseract/tesseract.min.js", // <-- ¡AÑADIDO! El script principal.
        "libs/tesseract/worker.min.js",    // El worker.
        "libs/tesseract/core/*",           // El core WASM y archivos relacionados.
        "langs/*"                          // Los archivos de idioma .traineddata.
      ],
      "matches": ["<all_urls>"] // Permite el acceso desde cualquier página.
    }
  ]
  // --- FIN: Recursos Web Accesibles ---
}
